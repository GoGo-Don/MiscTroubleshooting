#!/usr/bin/env bash

# Media info — snapshot at lock time
media=""
if command -v playerctl &>/dev/null; then
    media=$(playerctl metadata --format '♪ {{artist}} — {{title}}' 2>/dev/null)
fi

# Battery
bat_cap=$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null)
bat_sta=$(cat /sys/class/power_supply/BAT0/status 2>/dev/null)

battery=""
if [[ -n "$bat_cap" ]]; then
    if [[ "$bat_sta" == "Charging" ]]; then
        battery="⚡ ${bat_cap}% · charging"
    elif [[ "$bat_sta" == "Full" ]]; then
        battery="● ${bat_cap}% · full"
    else
        battery="${bat_cap}% · ${bat_sta,,}"
    fi
fi

# Build overlay text
text_parts=()
[[ -n "$media"   ]] && text_parts+=("$media")
[[ -n "$battery" ]] && text_parts+=("$battery")
text=$(IFS=$'\n'; echo "${text_parts[*]}")

if [[ -n "$text" ]]; then
    betterlockscreen -l blur --text "$text"
else
    betterlockscreen -l blur
fi
